{
  "id": "fizzbuzz",
  "title": { "en": "FizzBuzz" },
  "difficulty": "easy",
  "topics": ["loops", "conditions"],
  "description": {
    "en": "Print the numbers from 1 to `n`, one per line. For multiples of 3 print `Fizz` instead, for multiples of 5 print `Buzz`, and for multiples of both print `FizzBuzz`."
  },
  "inputs": [{ "name": "n", "kind": "number" }],
  "tests": [
    {
      "inputs": { "n": 15 },
      "expect": {
        "stdout": [
          "1",
          "2",
          "Fizz",
          "4",
          "Buzz",
          "Fizz",
          "7",
          "8",
          "Fizz",
          "Buzz",
          "11",
          "Fizz",
          "13",
          "14",
          "FizzBuzz"
        ]
      }
    },
    { "inputs": { "n": 1 }, "edge": true, "expect": { "stdout": ["1"] } },
    { "inputs": { "n": 3 }, "expect": { "stdout": ["1", "2", "Fizz"] } }
  ],
  "hints": [
    {
      "en": "Use a **for** block from 1 up to `n + 1`, and inside it an **if** whose condition is that the remainder of `i` divided by 15 equals 0: type `i % 15 == 0`."
    },
    {
      "en": "Test 15 first, then 3, then 5, each **if** on the **No** side of the one before; testing 3 first would print `Fizz` for 15."
    },
    { "en": "Print the word on each **Yes** side, and `i` itself on the last **No** side." }
  ],
  "takeaway": { "en": "Nested **if** blocks tested the divisible-by-15 case before 3 and 5." },
  "solution": {
    "version": 1,
    "title": "FizzBuzz",
    "challengeId": "fizzbuzz",
    "inputs": [{ "name": "n", "kind": "number" }],
    "classes": [],
    "functions": [],
    "main": [
      {
        "id": "fzb-loop-001",
        "kind": "for",
        "var": "i",
        "start": { "id": "fzb-one0-001", "kind": "num", "value": 1, "float": false, "raw": "1" },
        "stop": {
          "id": "fzb-stop-001",
          "kind": "binop",
          "op": "+",
          "left": { "id": "fzb-nvar-001", "kind": "var", "name": "n" },
          "right": { "id": "fzb-one0-002", "kind": "num", "value": 1, "float": false, "raw": "1" }
        },
        "body": [
          {
            "id": "fzb-if15-001",
            "kind": "if",
            "cond": {
              "id": "fzb-eq15-001",
              "kind": "binop",
              "op": "==",
              "left": {
                "id": "fzb-md15-001",
                "kind": "binop",
                "op": "%",
                "left": { "id": "fzb-ivar-001", "kind": "var", "name": "i" },
                "right": {
                  "id": "fzb-n15x-001",
                  "kind": "num",
                  "value": 15,
                  "float": false,
                  "raw": "15"
                }
              },
              "right": {
                "id": "fzb-zero-001",
                "kind": "num",
                "value": 0,
                "float": false,
                "raw": "0"
              }
            },
            "then": [
              {
                "id": "fzb-prfb-001",
                "kind": "print",
                "args": [{ "id": "fzb-txfb-001", "kind": "str", "value": "FizzBuzz" }]
              }
            ],
            "else": [
              {
                "id": "fzb-if03-001",
                "kind": "if",
                "cond": {
                  "id": "fzb-eq03-001",
                  "kind": "binop",
                  "op": "==",
                  "left": {
                    "id": "fzb-md03-001",
                    "kind": "binop",
                    "op": "%",
                    "left": { "id": "fzb-ivar-002", "kind": "var", "name": "i" },
                    "right": {
                      "id": "fzb-n03x-001",
                      "kind": "num",
                      "value": 3,
                      "float": false,
                      "raw": "3"
                    }
                  },
                  "right": {
                    "id": "fzb-zero-002",
                    "kind": "num",
                    "value": 0,
                    "float": false,
                    "raw": "0"
                  }
                },
                "then": [
                  {
                    "id": "fzb-prfz-001",
                    "kind": "print",
                    "args": [{ "id": "fzb-txfz-001", "kind": "str", "value": "Fizz" }]
                  }
                ],
                "else": [
                  {
                    "id": "fzb-if05-001",
                    "kind": "if",
                    "cond": {
                      "id": "fzb-eq05-001",
                      "kind": "binop",
                      "op": "==",
                      "left": {
                        "id": "fzb-md05-001",
                        "kind": "binop",
                        "op": "%",
                        "left": { "id": "fzb-ivar-003", "kind": "var", "name": "i" },
                        "right": {
                          "id": "fzb-n05x-001",
                          "kind": "num",
                          "value": 5,
                          "float": false,
                          "raw": "5"
                        }
                      },
                      "right": {
                        "id": "fzb-zero-003",
                        "kind": "num",
                        "value": 0,
                        "float": false,
                        "raw": "0"
                      }
                    },
                    "then": [
                      {
                        "id": "fzb-prbz-001",
                        "kind": "print",
                        "args": [{ "id": "fzb-txbz-001", "kind": "str", "value": "Buzz" }]
                      }
                    ],
                    "else": [
                      {
                        "id": "fzb-prnt-001",
                        "kind": "print",
                        "args": [{ "id": "fzb-ivar-004", "kind": "var", "name": "i" }]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
