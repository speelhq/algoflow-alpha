{
  "id": "max-of-three",
  "title": { "en": "Max of three" },
  "difficulty": "easy",
  "topics": ["conditions"],
  "description": {
    "en": "Store the largest of `a`, `b`, and `c` in `biggest` using **if** blocks, not the `max` builtin."
  },
  "inputs": [
    { "name": "a", "value": 3 },
    { "name": "b", "value": 9 },
    { "name": "c", "value": 5 }
  ],
  "tests": [
    {
      "inputs": { "a": 3, "b": 9, "c": 5 },
      "expect": { "variables": { "biggest": 9 } }
    },
    {
      "inputs": { "a": 3, "b": 3, "c": 3 },
      "edge": true,
      "expect": { "variables": { "biggest": 3 } }
    },
    {
      "inputs": { "a": -5, "b": -2, "c": -9 },
      "expect": { "variables": { "biggest": -2 } }
    },
    {
      "inputs": { "a": 1, "b": 2, "c": 7 },
      "expect": { "variables": { "biggest": 7 } }
    }
  ],
  "hints": [
    { "en": "Use two **if** blocks, one for `b` and one for `c`." },
    {
      "en": "Each **if** asks whether its value is greater than `biggest`, the largest so far: `b > biggest`."
    },
    {
      "en": "Before them, set `biggest` to `a`; on the **Yes** side of each, set `biggest` to that value."
    }
  ],
  "takeaway": { "en": "Two **if** blocks replaced `biggest` whenever a larger value appeared." },
  "solution": {
    "version": 1,
    "title": "Max of three",
    "challengeId": "max-of-three",
    "inputs": [
      { "name": "a", "value": 3 },
      { "name": "b", "value": 9 },
      { "name": "c", "value": 5 }
    ],
    "classes": [],
    "functions": [],
    "main": [
      {
        "id": "max-init-001",
        "kind": "assign",
        "target": { "kind": "var", "name": "biggest" },
        "value": { "id": "max-avar-001", "kind": "var", "name": "a" }
      },
      {
        "id": "max-ifb0-001",
        "kind": "if",
        "cond": {
          "id": "max-gtb0-001",
          "kind": "binop",
          "op": ">",
          "left": { "id": "max-bvar-001", "kind": "var", "name": "b" },
          "right": { "id": "max-big0-001", "kind": "var", "name": "biggest" }
        },
        "then": [
          {
            "id": "max-setb-001",
            "kind": "assign",
            "target": { "kind": "var", "name": "biggest" },
            "value": { "id": "max-bvar-002", "kind": "var", "name": "b" }
          }
        ],
        "else": []
      },
      {
        "id": "max-ifc0-001",
        "kind": "if",
        "cond": {
          "id": "max-gtc0-001",
          "kind": "binop",
          "op": ">",
          "left": { "id": "max-cvar-001", "kind": "var", "name": "c" },
          "right": { "id": "max-big0-002", "kind": "var", "name": "biggest" }
        },
        "then": [
          {
            "id": "max-setc-001",
            "kind": "assign",
            "target": { "kind": "var", "name": "biggest" },
            "value": { "id": "max-cvar-002", "kind": "var", "name": "c" }
          }
        ],
        "else": []
      }
    ]
  }
}
