{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "playwright-report/**", "test-results/**"],
  "rules": {
    // The automatic JSX runtime (`jsx: react-jsx`) never needs `React` in scope.
    "react/react-in-jsx-scope": "off",
    // The resize handle is an interactive `role="separator"` (a splitter); `<hr>` is a static one.
    "jsx-a11y/prefer-tag-over-role": "off",
    // The literal and variable runners are generators that never yield, by design.
    "require-yield": "off",
    // The spec names the regions of an `if` `then` and `else`.
    "unicorn/no-thenable": "off",
    // `Id | "main"` and `NodeId | "main"` are written as in the spec, to document intent.
    "typescript/no-redundant-type-constituents": "off",
    // An assertion stands where something the type checker cannot follow establishes a value's
    // shape (the registry's slot list, a check after `JSON.parse`); stating each in the types
    // would cost more than it shows.
    "typescript/no-unsafe-type-assertion": "off",
    // TypeScript already rejects a function with a return type that can end without a value,
    // which covers the exhaustive switches; an effect returns its cleanup only when it set
    // something up.
    "typescript/consistent-return": "off",
    // A helper that serves one function or one test stays beside its use.
    "unicorn/consistent-function-scoping": "off",
    // Each pass of these loops depends on the one before: a batch waits for the timer before the
    // next, and Playwright's assertions run in order, which `Promise.all` would race.
    "no-await-in-loop": "off",
    // A copy is the point where a map spreads: published frames and a node's parts are never
    // changed in place.
    "oxc/no-map-spread": "off"
  },
  "overrides": [
    {
      "files": ["src/ui/primitives/**"],
      "rules": {
        // Generated by shadcn and regenerated, never edited (ARCHITECTURE.md).
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": ["src/lang/**", "src/runtime/**", "src/python/**", "src/nodes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "@*",
                  "!.",
                  "!./**",
                  "!@/lang",
                  "!@/runtime",
                  "!@/python",
                  "!@/nodes",
                  "!@/lang/**",
                  "!@/runtime/**",
                  "!@/python/**",
                  "!@/nodes/**",
                  "./**/../**",
                  "./**/..",
                  "@/**/../**",
                  "@/**/.."
                ],
                "message": "src/lang, src/runtime, src/python, and src/nodes import only each other: through @/ across folders, through ./ within one (ARCHITECTURE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lang/**/*.test.ts",
        "src/runtime/**/*.test.ts",
        "src/python/**/*.test.ts",
        "src/nodes/**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "@*",
                  "!.",
                  "!./**",
                  "!@/lang",
                  "!@/runtime",
                  "!@/python",
                  "!@/nodes",
                  "!@/lang/**",
                  "!@/runtime/**",
                  "!@/python/**",
                  "!@/nodes/**",
                  "!vitest",
                  "!@/i18n/**",
                  "./**/../**",
                  "./**/..",
                  "@/**/../**",
                  "@/**/.."
                ],
                "message": "src/lang, src/runtime, src/python, and src/nodes import only each other: through @/ across folders, through ./ within one (ARCHITECTURE.md)."
              }
            ]
          }
        ]
      }
    }
  ]
}
